{
  "name": "ai-platform",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ai-platform",
      "version": "0.0.1",
      "workspaces": [
        "packages/*",
        "apps/*",
        "integrations/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@ai-platform/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@ai-platform/db": {
      "resolved": "packages/db",
      "link": true
    },
    "node_modules/@ai-platform/mock-providers": {
      "resolved": "packages/mock-providers",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@ai-platform/contracts",
      "version": "0.0.1",
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/db": {
      "name": "@ai-platform/db",
      "version": "0.0.1",
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/mock-providers": {
      "name": "@ai-platform/mock-providers",
      "version": "0.0.1",
      "dependencies": {
        "@ai-platform/contracts": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    }
  }
}
