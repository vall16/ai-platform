{
  "name": "@ai-platform/db",
  "version": "0.0.1",
  "private": true,
  "description": "Database schema, migrations, and data access layer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/pg": "^8.11.0"
  }
}
